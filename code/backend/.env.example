# Copy this file to .env and fill in the values.
# The API server and the MQTT bridge both read from it.

# --- Required by the API server ---
PORT=5001
CONNECTION_STRING2=mongodb://127.0.0.1:27017/beezee
ACCESS_TOKEN_SECRET=change-me-to-any-long-random-string

# --- Required by the MQTT bridge (npm run bridge) ---
# Leave as localhost when Mosquitto runs on the same machine as the bridge.
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC=beehive/metrics

# --- Only needed for the camera feature (S3 upload) ---
# Leave blank for the offline demo; camera endpoints will not work without them.
BUCKET_NAME=
BUCKET_REGION=
ACCESS_KEY=
SECRET_ACCESS_KEY=
